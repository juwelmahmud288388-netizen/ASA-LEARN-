rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'juwelmahmud288388@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Publicly readable educational resources (PDFs, thumbnails) managed by Admins
    match /curriculum/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('application/pdf') || request.resource.contentType.matches('image/.*'));
    }

    // Private student uploaded study PDFs for AI Tutor
    match /studentUploads/{uid}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
  }
}
